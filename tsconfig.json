{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server.ts", "server/**/*.ts", "frontend/src/**/*"],
  "exclude": ["node_modules", "public", "frontend/dist"]
}
